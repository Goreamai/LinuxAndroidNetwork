# NEXUS appliance configuration. No secrets belong in this file.
INTERFACE="wlan0"
HOSTNAME="nexus"
DNS_NAME="example.invalid"
REMOTE_HOST="relay.example.net"
REMOTE_PORT="22"
SSH_USER="nexus-tunnel"
SSH_KEY="/etc/nexus/ssh/id_ed25519"
SSH_KNOWN_HOSTS="/etc/nexus/ssh/known_hosts"
REMOTE_BIND_HOST="127.0.0.1"
REMOTE_BIND_PORT="25565"
LOCAL_HOST="192.168.1.10"
LOCAL_PORT="25565"
CHECK_INTERVAL="30"
RECONNECT_DELAY="5"
